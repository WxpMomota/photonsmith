# Cosmic Voyage: a minute's journey through the universe, with no one in it - a showcase of what the renderer draws in space (src/shared/cartoon/film_cosmos.h,
# film_planets.h, film_voyage.h). Seven parts, each its own stretch of space on the empty stage (`set void`), joined by dissolves.
film    cosmic-voyage
name    Cosmic Voyage
about   A minute's journey through the universe: a spiral galaxy, the pillars of a nebula, a raging star, a ringed giant, an asteroid field, a black hole and a supernova.
tags    emissive, night
still   33
title   at 0.5 for 3

part "The galaxy"
set     void
length  9
space   stars 1  milkyway 0.6  sun off
galaxy  swirl  at 0 0 -60000  size 50000  tilt 30  turn 20  brightness 2
galaxy  far1   at 160000 30000 -140000  size 20000  kind elliptical  tilt 40
galaxy  far2   at -150000 -40000 -120000  size 25000  kind barred  tilt 30  turn 70
shot 0 Falling into the galaxy
  spacecam zoom  0 0 -60000  from 300000  to 42000  bearing 0  elevation 30

part "The pillars" dissolve 1.2
set     void
length  9
space   stars 1  milkyway 1  sun off
nebula  towers  at 0 0 -30000  size 20000  kind pillars  brightness 3
nebula  veil    at 0 4000 -75000  size 70000  kind emission  brightness 0.7  seed 4
star    blue    at -6000 9000 -36000  radius 600  temperature 26000  brightness 3
shot 0 Through the pillars
  key   0 2000 8000     0 0 -30000   45
  key   0 1000 -6000    0 0 -30000   45

part "The star" dissolve 1.2
set     void
length  9
space   stars 1  milkyway 1  sun off  flare 0.3  bloom 0.2
star    sol  at 0 0 -30000  radius 5000  kind sun  temperature 4300  prominences 22  flare 2.5  brightness 0.7
shot 0 Round the star
  spacecam orbit  0 0 -30000  radius 19000  degrees 40  from 0  elevation 10

part "The ringed giant" dissolve 1.2
set     void
length  10
space   stars 1  milkyway 1  sun 230 12  flare 0.25  bloom 0.12  planetshine 1.5
planet  giant  gas  at 0 0 -40000  radius 8000  tilt 24  rings 1.3 2.5  flow 1  storms 3
moon    io     lava  of giant  radius 600   orbit 22000  period 90  phase 200
moon    europa ice   of giant  radius 500   orbit 30000  period 140 phase 150
shot 0 Round the giant
  spacecam orbit  0 0 -40000  radius 34000  degrees 55  from 300  elevation 9

part "The asteroid field" dissolve 1
set     void
length  8
space   stars 1  milkyway 1  sun 100 20  flare 0.3  bloom 0.1
asteroids  chase  at 0 0 -3000  kind field  radius 2500  count 1800  size 120
planet  rust  desert  at 30000 6000 -60000  radius 7000  air 1  colour orange
shot 0 Through the rocks
  key   0 60 3000     0 0 -3000   50
  key   40 -20 -500   60 10 -8000  50
  key   -30 0 -5000   200 300 -12000  50

part "The black hole" dissolve 1.2
set     void
length  9
space   stars 1  milkyway 1  sun off  bloom 0.25
blackhole  maw  at 0 0 -30000  radius 2000  tilt 9  jets 18  disc 12  brightness 2
shot 0 Round the black hole
  spacecam orbit  0 0 -30000  radius 26000  degrees 35  from 330  elevation 11

part "The supernova" dissolve 1
set     void
length  6
space   stars 1  milkyway 1  sun off  bloom 0.3  flare 0.4
timelapse 3
remnant  crab  at 0 0 -40000  size 20000  kind supernova  blast 3
shot 0 The star dies
  key   0 0 -16000   0 0 -40000   55
  key   0 3000 -6000   0 0 -40000   55
