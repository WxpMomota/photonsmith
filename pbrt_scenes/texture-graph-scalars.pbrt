# @rt-category Test Scenes
# @rt-description Graphs of textures on a roughness and on a mix amount, per pixel: three spheres (copper, coated diffuse, coated gold) whose roughness is a picture scaled or mixed by another, and a wall that mixes two materials by such a graph, as pbrt draws them.
# @rt-performance Fast
# @rt-size 10
# texture-graph-scalars.pbrt -- a roughness (and a Mix material's "amount") bound to a "scale" of two pictures or a "mix" of two pictures and a number, not to one picture. Each is evaluated
# at every hit; their averages would draw an even roughness and an even blend. Original, no licence constraints.

LookAt 0 2.2 10   0 0.9 0   0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 8 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.25 0.3 0.4 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -2 3.5 -2   2 3.5 -2   2 3.5 2   -2 3.5 2 ]
AttributeEnd

Texture "checker" "float" "imagemap" "string filename" [ "texture-params-rough.png" ] "string encoding" [ "linear" ]
Texture "mask" "float" "imagemap" "string filename" [ "texture-params-amount.png" ] "string encoding" [ "linear" ]
Texture "scaled-rough" "float" "scale" "texture tex" [ "checker" ] "texture scale" [ "mask" ]
Texture "mixed-rough" "float" "mix" "texture tex1" [ "checker" ] "float tex2" [ 0.02 ] "texture amount" [ "mask" ]
Texture "mixed-amount" "float" "mix" "texture tex1" [ "mask" ] "float tex2" [ 1 ] "texture amount" [ "checker" ]

Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.45 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -7 0 -6   7 0 -6   7 0 6   -7 0 6 ]

AttributeBegin
  Translate -2.2 0.9 0
  Material "conductor" "spectrum eta" "metal-Cu-eta" "spectrum k" "metal-Cu-k" "texture roughness" [ "mixed-rough" ]
  Shape "sphere" "float radius" 0.9
AttributeEnd

AttributeBegin
  Translate 0 0.9 0
  Material "coateddiffuse" "rgb reflectance" [ 0.7 0.2 0.15 ] "texture roughness" [ "scaled-rough" ]
  Shape "sphere" "float radius" 0.9
AttributeEnd

AttributeBegin
  Translate 2.2 0.9 0
  Material "coatedconductor" "spectrum conductor.eta" "metal-Au-eta" "spectrum conductor.k" "metal-Au-k"
    "texture interface.roughness" [ "scaled-rough" ] "texture conductor.roughness" [ "mixed-rough" ]
  Shape "sphere" "float radius" 0.9
AttributeEnd

# A wall that blends a pale and a dark material by a graph of pictures (triangles with uv: the recursive OptiX backend reads the amount on triangles).
MakeNamedMaterial "pale" "string type" [ "diffuse" ] "rgb reflectance" [ 0.85 0.8 0.7 ]
MakeNamedMaterial "dark" "string type" [ "diffuse" ] "rgb reflectance" [ 0.08 0.12 0.2 ]
Material "mix" "string materials" [ "pale" "dark" ] "texture amount" [ "mixed-amount" ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -7 0 -3   7 0 -3   7 6 -3   -7 6 -3 ]
  "point2 uv" [ 0 0   2 0   2 1   0 1 ]
