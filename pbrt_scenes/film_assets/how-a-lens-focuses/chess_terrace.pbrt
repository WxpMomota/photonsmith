# The Chess Terrace - an original set: chess at dusk by candlelight, strings of lights across the garden (written by chess_terrace.py; see its header).
LookAt 0.05 0.86 0.48   0.0 0.80 -0.10   0 1 0
Camera "perspective" "float fov" [ 38 ] "float lensradius" [ 0.012 ] "float focaldistance" [ 0.45 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
# the dusk sky: a deep blue glow over everything (no sun: it has set)
LightSource "infinite" "rgb L" [ 0.045 0.065 0.130 ]
# a paper lantern hanging high over the table, out of every shot: the warm light the board is lit by
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 55.0 38.5 21.0 ]
  Material "diffuse" "rgb reflectance" [ 0.8 0.75 0.65 ]
  Translate -0.15 2.60 -0.02
  Shape "sphere" "float radius" [ 0.20 ]
AttributeEnd
Texture "board" "spectrum" "imagemap" "string filename" [ "board.png" ]
Texture "slabs" "spectrum" "imagemap" "string filename" [ "slabs.png" ]
Texture "table_marble" "spectrum" "imagemap" "string filename" [ "table_marble.png" ]
Texture "balustrade" "spectrum" "imagemap" "string filename" [ "balustrade.png" ]
Texture "hedge" "spectrum" "imagemap" "string filename" [ "hedge.png" ]
Texture "lawn" "spectrum" "imagemap" "string filename" [ "lawn.png" ]
AttributeBegin
Material "diffuse" "texture reflectance" "slabs"
Shape "plymesh" "string filename" [ "meshes/m000.ply" ]

AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "lawn"
Shape "plymesh" "string filename" [ "meshes/m001.ply" ]

AttributeEnd
