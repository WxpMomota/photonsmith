# The set of "A Walk at Dusk" (pbrt_scenes/a-walk-at-dusk.film): a sandy flat under a dusk sky, a few stones, a path of pale slabs and a lantern on a post.
LookAt 4 2.2 8  0 1 0  0 1 0
Camera "perspective" "float fov" [ 38 ]
Film "rgb" "integer xresolution" [ 1280 ] "integer yresolution" [ 720 ]
Sampler "halton" "integer pixelsamples" [ 32 ]
Integrator "volpath" "integer maxdepth" [ 6 ]
WorldBegin

# the dusk sky and the low sun
LightSource "infinite" "rgb L" [ 0.07 0.09 0.17 ]
LightSource "distant" "point3 from" [ -6 2.2 -8 ] "point3 to" [ 0 0 0 ] "rgb L" [ 1.7 0.75 0.3 ]

# the ground
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.62 0.48 0.34 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -60 0 -60   60 0 -60   60 0 60   -60 0 60 ]
AttributeEnd

# stones
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.36 0.34 0.33 ]
  AttributeBegin
    Translate -2.2 0.25 -2
    Scale 1.3 0.6 1
    Shape "sphere" "float radius" [ 0.45 ]
  AttributeEnd
  AttributeBegin
    Translate 3.4 0.3 -7.5
    Scale 1 0.7 1.4
    Shape "sphere" "float radius" [ 0.5 ]
  AttributeEnd
  AttributeBegin
    Translate -3.5 0.6 -9
    Scale 1.6 1.1 1.2
    Shape "sphere" "float radius" [ 0.7 ]
  AttributeEnd
AttributeEnd

# the path: pale slabs from where the walk starts to the lantern
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.78 0.74 0.66 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3   4 5 6  4 6 7   8 9 10  8 10 11 ]
    "point3 P" [ -0.5 0.01 4.5   0.5 0.01 4.5   0.5 0.01 1.5   -0.5 0.01 1.5
                 -0.5 0.01 1.0   0.5 0.01 1.0   0.5 0.01 -1.5   -0.5 0.01 -1.5
                 0.2 0.01 -2.0   1.2 0.01 -2.0   2.0 0.01 -5.5   1.0 0.01 -5.5 ]
AttributeEnd

# the lantern's post
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.25 0.18 0.12 ]
  Translate 2.6 0 -6.4
  Rotate -90 1 0 0
  Shape "cylinder" "float radius" [ 0.05 ] "float zmin" [ 0 ] "float zmax" [ 1.9 ]
AttributeEnd

# @anim lantern
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 8 5 2.2 ]
  Translate 2.6 2.0 -6.4
  Shape "sphere" "float radius" [ 0.13 ]
AttributeEnd
