# The Sun Hall - an original domed marble rotunda, lit by the sun through an oculus (written by sun_hall.py; see its header).
LookAt 0 2.0 15   0 8.5 -10   0 1 0
Camera "perspective" "float fov" [ 70 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
# the sky (seen only through the oculus) and the sun, 58 degrees up behind the opening camera: its beam falls through the oculus low on the far wall,
# behind the columns
LightSource "infinite" "rgb L" [ 1.10 1.40 2.00 ]
LightSource "distant" "point3 from" [ 0.25 1.6 1.0 ] "point3 to" [ 0 0 0 ] "rgb L" [ 36.0 32.0 26.0 ]
Texture "floor" "spectrum" "imagemap" "string filename" [ "floor.png" ]
Texture "mosaic" "spectrum" "imagemap" "string filename" [ "mosaic.png" ]
Texture "wall" "spectrum" "imagemap" "string filename" [ "wall.png" ]
Texture "coffer" "spectrum" "imagemap" "string filename" [ "coffer.png" ]
Texture "col_giallo" "spectrum" "imagemap" "string filename" [ "column_giallo.png" ]
Texture "col_serpentine" "spectrum" "imagemap" "string filename" [ "column_serpentine.png" ]
Texture "col_pavonazzetto" "spectrum" "imagemap" "string filename" [ "column_pavonazzetto.png" ]
Texture "stone_cream" "spectrum" "imagemap" "string filename" [ "stone_cream.png" ]
Texture "stone_serpentine" "spectrum" "imagemap" "string filename" [ "stone_serpentine.png" ]
Texture "stone_pavonazzetto" "spectrum" "imagemap" "string filename" [ "stone_pavonazzetto.png" ]
AttributeBegin
Material "coateddiffuse" "texture reflectance" "floor" "float roughness" [ 0.04 ]
Shape "plymesh" "string filename" [ "meshes/m000.ply" ]

AttributeEnd
AttributeBegin
Material "coateddiffuse" "texture reflectance" "mosaic" "float roughness" [ 0.08 ]
Shape "plymesh" "string filename" [ "meshes/m001.ply" ]

AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "wall"
Shape "plymesh" "string filename" [ "meshes/m002.ply" ]

AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "stone_cream"
Shape "plymesh" "string filename" [ "meshes/m003.ply" ]

Shape "plymesh" "string filename" [ "meshes/m004.ply" ]

AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "stone_cream"
Shape "plymesh" "string filename" [ "meshes/m005.ply" ]

Material "conductor" "rgb eta" [ 0.143 0.374 1.442 ] "rgb k" [ 3.983 2.385 1.603 ] "float roughness" [ 0.28 ]
Shape "plymesh" "string filename" [ "meshes/m006.ply" ]

Material "diffuse" "texture reflectance" "col_giallo" "string normalmap" [ "column_flutes.png" ]
Shape "plymesh" "string filename" [ "meshes/m007.ply" ]

