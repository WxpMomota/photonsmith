# Islands in the Sky - floating islands over a sea of cloud (written by scripts/dreams/sky_islands.py; see its header). Metres, +y up; the cloud sea
# lies from 0 to about 170 m, the islands float from 250 m to 700 m. The film adds the sky, the clouds, the haze, the trees, the birds and the waterfall.
LookAt 180 470 300   -400 420 -300   0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
LightSource "infinite" "rgb L" [ 0.5 0.6 0.8 ]
Texture "meadow" "spectrum" "imagemap" "string filename" [ "meadow.png" ]
Texture "rock" "spectrum" "imagemap" "string filename" [ "rock.png" ]
Texture "lip" "spectrum" "imagemap" "string filename" [ "lip.png" ] "float uscale" [ 4 ] "float vscale" [ 4 ]
# @anim moon
AttributeBegin
LightSource "distant" "point3 from" [ -0.80 0.20 -0.56 ] "point3 to" [ 0 0 0 ] "rgb L" [ 0.030 0.034 0.045 ]
AreaLightSource "diffuse" "rgb L" [ 3.2 3.3 3.5 ]
Material "diffuse" "rgb reflectance" [ 0 0 0 ]
Translate -6400 1700 -4480
Shape "sphere" "float radius" [ 95 ]
AttributeEnd
# the island "great"
AttributeBegin
Material "diffuse" "texture reflectance" "meadow"
Shape "plymesh" "string filename" [ "meshes/m000.ply" ]
AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "lip"
Shape "plymesh" "string filename" [ "meshes/m001.ply" ]
Material "diffuse" "texture reflectance" "rock"
Shape "plymesh" "string filename" [ "meshes/m002.ply" ]
AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "rock"
Shape "plymesh" "string filename" [ "meshes/m003.ply" ]
AttributeEnd
AttributeBegin
Material "diffuse" "rgb reflectance" [ 0.12 0.10 0.07 ]
Shape "plymesh" "string filename" [ "meshes/m004.ply" ]
AttributeEnd
