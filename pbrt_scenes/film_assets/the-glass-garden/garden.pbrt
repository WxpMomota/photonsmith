# The Glass Garden - a mossy hollow at sunset where giant flowers of coloured glass grow round a still pond (written by scripts/dreams/glass_garden.py; see
# its header). Metres, +y up. The film adds the sky, the mist round the camera, the trees, the
# fireflies and the fungi.
LookAt 14 4.5 9   -5 3 0   0 1 0
Camera "perspective" "float fov" [ 50 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
LightSource "infinite" "rgb L" [ 0.6 0.7 0.9 ]
Texture "moss" "spectrum" "imagemap" "string filename" [ "moss.png" ] "string mapping" [ "uv" ]
Texture "hills" "spectrum" "imagemap" "string filename" [ "hills.png" ]
Texture "mud" "spectrum" "imagemap" "string filename" [ "mud.png" ] "float uscale" [ 2 ] "float vscale" [ 2 ]
AttributeBegin
Material "diffuse" "texture reflectance" "moss" "string normalmap" [ "moss_n.png" ]
Shape "plymesh" "string filename" [ "meshes/m000.ply" ]
Material "coateddiffuse" "texture reflectance" "mud" "float roughness" [ 0.3 ]
Shape "plymesh" "string filename" [ "meshes/m001.ply" ]
AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "hills"
Shape "plymesh" "string filename" [ "meshes/m002.ply" ]
AttributeEnd
AttributeBegin
Material "dielectric" "float eta" [ 1.333 ]
Shape "plymesh" "string filename" [ "meshes/m003.ply" ]
AttributeEnd
# @anim moon
AttributeBegin
LightSource "distant" "point3 from" [ 0.80 0.42 -0.42 ] "point3 to" [ 0 0 0 ] "rgb L" [ 0.040 0.048 0.070 ]
AreaLightSource "diffuse" "rgb L" [ 0.9 0.95 1.05 ]
Material "diffuse" "rgb reflectance" [ 0 0 0 ]
Translate 2400 1260 -1260
Shape "sphere" "float radius" [ 30 ]
AttributeEnd
# the rose flower
AttributeBegin
Material "dielectric" "float eta" [ 1.52 ] "float abbenumber" [ 26 ]
Shape "plymesh" "string filename" [ "meshes/m004.ply" ]
AttributeEnd
AttributeBegin
Material "dielectric" "float eta" [ 1.5 ] "rgb tf" [ 0.645 0.972 0.604 ]
Shape "plymesh" "string filename" [ "meshes/m005.ply" ]
AttributeEnd
AttributeBegin
Material "dielectric" "float eta" [ 1.5 ] "rgb tf" [ 1.000 0.516 0.668 ]
Shape "plymesh" "string filename" [ "meshes/m006.ply" ]
AttributeEnd
AttributeBegin
