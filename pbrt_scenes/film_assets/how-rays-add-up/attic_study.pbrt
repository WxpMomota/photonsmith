# The Attic Study - an original set: a study under the roof at night, a desk lamp and the moon (written by attic_study.py; see its header).
LookAt 0.9 1.45 2.6   -0.6 0.95 -2.2   0 1 0
Camera "perspective" "float fov" [ 55 ]
Film "rgb" "integer xresolution" [ 1920 ] "integer yresolution" [ 1080 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
# the night outside, seen through the window, and the moon: its light falls through the window in a square on the floor, onto the chair
LightSource "infinite" "rgb L" [ 0.06 0.08 0.16 ]
LightSource "distant" "point3 from" [ -0.12 1.1 -1.0 ] "point3 to" [ 0 0 0 ] "rgb L" [ 3.6 4.2 5.7 ]
Texture "floor" "spectrum" "imagemap" "string filename" [ "floor.png" ]
Texture "roof" "spectrum" "imagemap" "string filename" [ "roof.png" ]
Texture "plaster" "spectrum" "imagemap" "string filename" [ "plaster.png" ]
Texture "rug" "spectrum" "imagemap" "string filename" [ "rug.png" ]
Texture "globe" "spectrum" "imagemap" "string filename" [ "globe.png" ]
Texture "pages" "spectrum" "imagemap" "string filename" [ "pages.png" ]
AttributeBegin
Material "coateddiffuse" "texture reflectance" "floor" "float roughness" [ 0.25 ]
Shape "plymesh" "string filename" [ "meshes/m000.ply" ]

AttributeEnd
AttributeBegin
Material "diffuse" "texture reflectance" "plaster"
Shape "plymesh" "string filename" [ "meshes/m001.ply" ]

Shape "plymesh" "string filename" [ "meshes/m002.ply" ]

Shape "plymesh" "string filename" [ "meshes/m003.ply" ]

AttributeEnd
