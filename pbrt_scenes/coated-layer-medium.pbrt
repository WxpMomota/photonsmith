# @rt-category Test Scenes
# @rt-description Coated materials with a scattering layer: a coated diffuse sphere and a coated conductor sphere whose coat is a medium (albedo, g, thickness, maxdepth, nsamples), as pbrt draws them.
# @rt-performance Fast
# @rt-size 6
# coated-layer-medium.pbrt -- pbrt's LayeredBxDF walks a random path inside the coat: "thickness" (default 0.01), the medium's single-scattering "albedo" (default 0: a clear layer) and
# Henyey-Greenstein "g", and the walk's "maxdepth" (10) and "nsamples" (1). These used to be ignored with a warning; the renderers draw them now. Original, no licence constraints.

LookAt 0 1.4 6   0 0.9 0   0 1 0
Camera "perspective" "float fov" [ 40 ]

Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 8 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.3 0.35 0.45 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1.5 3.5 -1.5   1.5 3.5 -1.5   1.5 3.5 1.5   -1.5 3.5 1.5 ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.55 0.55 0.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 0 -6   6 0 -6   6 0 6   -6 0 6 ]

AttributeBegin
  Translate -1.1 0.9 0
  Material "coateddiffuse" "rgb reflectance" [ 0.8 0.25 0.2 ] "float roughness" [ 0.1 ]
    "rgb albedo" [ 0.95 0.95 0.95 ] "float g" [ 0.6 ] "float thickness" [ 0.5 ] "integer maxdepth" [ 16 ] "integer nsamples" [ 2 ]
  Shape "sphere" "float radius" 0.9
AttributeEnd

AttributeBegin
  Translate 1.1 0.9 0
  Material "coatedconductor" "spectrum conductor.eta" "metal-Au-eta" "spectrum conductor.k" "metal-Au-k"
    "float interface.roughness" [ 0.05 ] "float conductor.roughness" [ 0.2 ]
    "rgb albedo" [ 0.9 0.9 0.9 ] "float g" [ -0.4 ] "float thickness" [ 0.4 ] "integer maxdepth" [ 12 ]
  Shape "sphere" "float radius" 0.9
AttributeEnd
