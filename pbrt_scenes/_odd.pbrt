LookAt 0 3 7  0 0 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
WorldBegin
LightSource "distant" "point3 from" [ 2 4 3 ] "point3 to" [ 0 0 0 ] "rgb L" [ 4 4 4 ]
Texture "h" "float" "imagemap" "string filename" [ "/tmp/ib/height.png" ] "float uscale" [ 1 ] "float vscale" [ 1 ]
Texture "b" "float" "scale" "texture tex" [ "h" ] "float scale" [ 0.3 ]
Material "diffuse" "rgb reflectance" [ 0.6 0.4 0.3 ] "texture displacement" [ "b" ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -3 0 -3  3 0 -3  3 0 3  -3 0 3 ] "point2 uv" [ 0 0 1 0 1 1 0 1 ]
