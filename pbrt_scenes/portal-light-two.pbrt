# @rt-category Test Scenes
# @rt-description A room with two wall openings, each with its own portal infinite light (a warm one in the back wall, a blue one in the left wall): pbrt sums the lights, so the room has both.
# @rt-performance Fast
# @rt-size 9
# portal-light-two.pbrt -- portal-light-constant.pbrt's room with a second window and a second portal light. A file with several infinite lights used to keep only the last; the pbrt-v4-scenes Watercolor
# has one portal light per window. Geometry is original, no licence constraints.

LookAt  0 1.5 6    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 50 ]

Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 400 ]
Sampler "halton" "integer pixelsamples" [ 96 ]

WorldBegin

# Two windows, one portal light each (pbrt sums them): a warm one in the back wall and a blue one in the left wall.
LightSource "infinite" "point3 portal" [ -1.5 0.2 -3   1.5 0.2 -3   1.5 2.8 -3   -1.5 2.8 -3 ]
  "rgb L" [ 1 0.85 0.6 ] "float scale" 3
LightSource "infinite" "point3 portal" [ -4 0.2 2   -4 0.2 -1   -4 2.8 -1   -4 2.8 2 ]
  "rgb L" [ 0.5 0.7 1 ] "float scale" 2

Material "diffuse" "rgb reflectance" [ 0.55 0.5 0.45 ]

# Back wall with a rectangular hole where the portal window sits.
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -1.5 0 -3   -1.5 3.5 -3   -4 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 1.5 0 -3   4 0 -3   4 3.5 -3   1.5 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0.2 -3   -4 0.2 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 2.8 -3   4 2.8 -3   4 3.5 -3   -4 3.5 -3 ]

Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0 6   -4 0 6 ]
# Left wall with a rectangular hole (z from -1 to 2, y from 0.2 to 2.8) where the second portal window sits.
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -4 3.5 -3   -4 3.5 -1   -4 0 -1 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 2   -4 3.5 2   -4 3.5 6   -4 0 6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -1   -4 0.2 -1   -4 0.2 2   -4 0 2 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 2.8 -1   -4 3.5 -1   -4 3.5 2   -4 2.8 2 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 4 0 6   4 3.5 6   4 3.5 -3   4 0 -3 ]
