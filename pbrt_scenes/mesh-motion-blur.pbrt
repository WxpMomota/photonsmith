# @rt-size 14
# mesh-motion-blur.pbrt -- object motion blur of a triangle mesh (ActiveTransform "StartTime"/"EndTime" around a trianglemesh), on every backend: the CPU blurs it with
# animated_transform_instance.h, the GPU with a two-key triangle GAS (OptixRenderer::setTriangleMotion: both OptiX renderers). The left box stands still (a crisp
# reference); the right box moves 2 m to the right over the shutter and should render as a soft horizontal streak, the same on the CPU and the GPU.
LookAt  5 2.5 10    5 1 0    0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 360 ]
Sampler "halton" "integer pixelsamples" [ 128 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.4 0.4 0.45 ]
AttributeBegin
  Translate 5 6 2
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd

# the floor
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.55 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -20 0 -20   20 0 -20   20 0 20   -20 0 20 ]
AttributeEnd

# the still box
AttributeBegin
  Translate 2.5 0 0
  Material "diffuse" "rgb reflectance" [ 0.8 0.25 0.2 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3   4 6 5  4 7 6   0 4 5  0 5 1   1 5 6  1 6 2   2 6 7  2 7 3   3 7 4  3 4 0 ]
    "point3 P" [ -0.5 0 -0.5   0.5 0 -0.5   0.5 0 0.5   -0.5 0 0.5   -0.5 1 -0.5   0.5 1 -0.5   0.5 1 0.5   -0.5 1 0.5 ]
AttributeEnd

# the moving box: from x = 6 to x = 8 over the shutter
AttributeBegin
  ActiveTransform "StartTime"
  Translate 6 0 0
  ActiveTransform "EndTime"
  Translate 8 0 0
  ActiveTransform "All"
  Material "diffuse" "rgb reflectance" [ 0.2 0.45 0.85 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3   4 6 5  4 7 6   0 4 5  0 5 1   1 5 6  1 6 2   2 6 7  2 7 3   3 7 4  3 4 0 ]
    "point3 P" [ -0.5 0 -0.5   0.5 0 -0.5   0.5 0 0.5   -0.5 0 0.5   -0.5 1 -0.5   0.5 1 -0.5   0.5 1 0.5   -0.5 1 0.5 ]
AttributeEnd
