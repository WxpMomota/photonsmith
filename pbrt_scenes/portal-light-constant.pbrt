# @rt-category Test Scenes
# @rt-description A room with one wall opening, lit through a portal infinite light of a constant colour (no picture): the window's patch of a uniform sky, which pbrt-v4 turns the colour into a picture to allow.
# @rt-performance Fast
# @rt-size 9
# portal-light-constant.pbrt -- portal-light.pbrt's room, with the portal light given "rgb L" instead of an environment picture (the pbrt-v4-scenes Kroken's light: "blackbody L" 6500
# with a "portal"). pbrt makes a picture of the colour so the portal can be used; a light with a portal and no picture used to fail closed to NO light, so a room lit only through
# its window rendered nearly black. Geometry is portal-light.pbrt's own: original, no licence constraints.

LookAt  0 1.5 6    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 50 ]

Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 400 ]
Sampler "halton" "integer pixelsamples" [ 96 ]

WorldBegin

LightSource "infinite" "point3 portal" [ -1.5 0.2 -3   1.5 0.2 -3   1.5 2.8 -3   -1.5 2.8 -3 ]
  "rgb L" [ 1 0.95 0.85 ] "float scale" 3

Material "diffuse" "rgb reflectance" [ 0.55 0.5 0.45 ]

# Back wall with a rectangular hole where the portal window sits.
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -1.5 0 -3   -1.5 3.5 -3   -4 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 1.5 0 -3   4 0 -3   4 3.5 -3   1.5 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0.2 -3   -4 0.2 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 2.8 -3   4 2.8 -3   4 3.5 -3   -4 3.5 -3 ]

Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0 6   -4 0 6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -4 3.5 -3   -4 3.5 6   -4 0 6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 4 0 6   4 3.5 6   4 3.5 -3   4 0 -3 ]
