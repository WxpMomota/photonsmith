# @rt-category Test Scenes
# @rt-description A closed box of thin glass with a ball and a floor inside, lit by the sun and the sky from outside: thin glass lets direct light through.
# @rt-performance Fast
# @rt-size 4
# thin-glass-tank.pbrt -- thin dielectric panes (Material "thindielectric") are crossed by the path tracer's shadow rays, scaled by what a pane
# transmits at that angle (ThinDielectricTransmittance), and the straight-through scatter off a pane is a free crossing that keeps the last real
# vertex's light-sampling weights. Everything inside a glass tank is then lit by next-event estimation through the glass instead of only by BSDF
# samples that happen to reach the sun (pbrt-v4, where every surface with a material blocks shadow rays, converges to the same answer with far more
# noise). The scene is a closed box, so every light the ball and the inner floor get has crossed a pane. Measured 2026-10-22 against pbrt-v4 at 4096
# samples: CPU and wavefront 1.002 of its mean; at 64 samples the error inside the box is 0.073 (CPU) and 0.063 (wavefront) against pbrt's 0.134.
# The sun is a glowing sphere, not a distant light, so pbrt can find it too: through glass pbrt never lights anything with a delta light (only a
# shadow ray could reach it), which this renderer now does (a distant sun through the panes read 3.2% above pbrt for exactly that reason).
#
# Original, not derived from any distributed scene, so it carries no licence constraints.
LookAt 1.6 1.1 2.2   0 0.25 0   0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 640 ] "integer yresolution" [ 400 ]
Sampler "zsobol" "integer pixelsamples" [ 256 ]
WorldBegin
AttributeBegin
  Translate 3 4 1
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 60 56 50 ]
  Shape "sphere" "float radius" [ 0.4 ]
AttributeEnd
LightSource "infinite" "rgb L" [ 0.25 0.3 0.4 ]
# the ground outside
Material "diffuse" "rgb reflectance" [ 0.45 0.42 0.38 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 -0.01 -6   6 -0.01 -6   6 -0.01 6   -6 -0.01 6 ]
# inside: a sand floor and a red ball
Material "diffuse" "rgb reflectance" [ 0.75 0.65 0.40 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -0.48 0.02 -0.28   0.48 0.02 -0.28   0.48 0.02 0.28   -0.48 0.02 0.28 ]
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.8 0.15 0.12 ]
  Translate 0.1 0.2 0
  Shape "sphere" "float radius" [ 0.18 ]
AttributeEnd
# the glass box: six thin panes
Material "thindielectric" "float eta" [ 1.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3   4 6 5  4 7 6   0 4 5  0 5 1   3 2 6  3 6 7   0 3 7  0 7 4   1 5 6  1 6 2 ]
  "point3 P" [ -0.5 0 -0.3   0.5 0 -0.3   0.5 0 0.3   -0.5 0 0.3   -0.5 0.6 -0.3   0.5 0.6 -0.3   0.5 0.6 0.3   -0.5 0.6 0.3 ]
