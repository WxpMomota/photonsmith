# @rt-category Test Scenes
# @rt-description A portal light and a plain sky together, as pbrt sums them: the same room as the portal light scene, with a dim uniform sky added, lighting the open roof and front.
# @rt-performance Fast
# @rt-size 9
# portal-light-plus-sky.pbrt -- LightSource "infinite" twice: one with "point3 portal" and a picture, one plain with a constant "rgb L". pbrt adds them. The renderers keep the plain
# sky beside the portal (FlatScene::skyBesidePortals): it used to be dropped with a warning. Uses portal-light-sky.exr. Original, no licence constraints.

LookAt  0 1.5 6    0 1.5 0    0 1 0
Camera "perspective" "float fov" [ 50 ]

Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 40 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

LightSource "infinite" "point3 portal" [ -1.5 0.2 -3   1.5 0.2 -3   1.5 2.8 -3   -1.5 2.8 -3 ]
  "string filename" [ "portal-light-sky.exr" ]

# A plain sky beside the portal: pbrt sums every infinite light, so the room is lit by the portal window AND by this uniform sky (the open roof and front).
LightSource "infinite" "rgb L" [ 0.12 0.16 0.24 ]

Material "diffuse" "rgb reflectance" [ 0.55 0.5 0.45 ]

# Back wall with a rectangular hole where the portal window sits.
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -1.5 0 -3   -1.5 3.5 -3   -4 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 1.5 0 -3   4 0 -3   4 3.5 -3   1.5 3.5 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0.2 -3   -4 0.2 -3 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 2.8 -3   4 2.8 -3   4 3.5 -3   -4 3.5 -3 ]

Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   4 0 -3   4 0 6   -4 0 6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -4 0 -3   -4 3.5 -3   -4 3.5 6   -4 0 6 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ 4 0 6   4 3.5 6   4 3.5 -3   4 0 -3 ]
