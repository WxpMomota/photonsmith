# @rt-category Test Scenes
# @rt-description Parameters bound to textures the renderers cannot evaluate per hit (a conductor's roughness map, a mix material's amount map, a scale of a colour by a map): each takes the texture's mean. The pictures are uniform grey, so the mean is exact and pbrt-v4 draws the same.
# @rt-performance Fast
# @rt-size 6
# texture-means.pbrt -- a conductor sphere whose roughness is an image (uniform 0.302), a floor that mixes two diffuse materials by an amount image (uniform 0.502), and a wall whose colour is
# a constant scaled by an image (uniform 0.6). The pbrt-v4-scenes Kroken and Watercolor bind dozens of such textures (roughness maps, dirt overlays); the renderers take their mean where a parameter
# would otherwise fall back to its default (a mirror, for a roughness). With uniform pictures that is exactly what pbrt evaluates per hit, so this scene is in the pbrt reference pack.
# Original, no licence constraints; the three pictures are 4 x 4 uniform greys.

LookAt 0 1.4 6   0 1 0   0 1 0
Camera "perspective" "float fov" [ 45 ]

Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 8 ]

WorldBegin

LightSource "infinite" "rgb L" [ 0.35 0.4 0.5 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 8 8 8 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
    "point3 P" [ -1 3.5 -1   1 3.5 -1   1 3.5 1   -1 3.5 1 ]
AttributeEnd

Texture "rough" "float" "imagemap" "string filename" [ "texture-means-rough.png" ] "string encoding" [ "linear" ]
Texture "amount" "float" "imagemap" "string filename" [ "texture-means-amount.png" ] "string encoding" [ "linear" ]
Texture "k" "float" "imagemap" "string filename" [ "texture-means-scale.png" ] "string encoding" [ "linear" ]
Texture "wallkd" "spectrum" "scale" "rgb tex" [ 0.8 0.55 0.4 ] "texture scale" [ "k" ]

MakeNamedMaterial "pale" "string type" [ "diffuse" ] "rgb reflectance" [ 0.8 0.8 0.75 ]
MakeNamedMaterial "dark" "string type" [ "diffuse" ] "rgb reflectance" [ 0.15 0.2 0.3 ]

# Floor: a mix of the two by the amount image.
Material "mix" "string materials" [ "pale" "dark" ] "texture amount" [ "amount" ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 0 -6   6 0 -6   6 0 6   -6 0 6 ]

# Back wall: a constant scaled by an image.
Material "diffuse" "texture reflectance" [ "wallkd" ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ]
  "point3 P" [ -6 0 -3   6 0 -3   6 5 -3   -6 5 -3 ]

# A copper-like conductor sphere, roughness from the image.
AttributeBegin
  Translate 0 1 0
  Material "conductor" "spectrum eta" "metal-Cu-eta" "spectrum k" "metal-Cu-k" "texture roughness" [ "rough" ]
  Shape "sphere" "float radius" 1
AttributeEnd
