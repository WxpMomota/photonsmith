# @rt-category Test Scenes
# @rt-description A small glowing ball inside a frosted glass ball: the rough-glass version of lamp-inside-glass.
# @rt-performance Fast
# @rt-size 4
# lamp-inside-rough-glass.pbrt -- lamp-inside-glass.pbrt with frosted glass (roughness 0.3): the transmission lobe of the rough dielectric, both the BSDF sample that
# reaches the lamp and the direct-light sample at the glass vertex, carries pbrt's radiance-mode 1 / eta'^2. Measured mean (64x64, 64 samples, depth 8): pbrt-v4 0.0296,
# CPU / recursive / wavefront OptiX 0.0296 / 0.0295 / 0.0295.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt 0 0 8   0 0 0   0 1 0
Camera "perspective" "float fov" [ 30 ]
Film "rgb" "integer xresolution" [ 200 ] "integer yresolution" [ 200 ]
Sampler "halton" "integer pixelsamples" [ 64 ]

WorldBegin

AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0 0 0 ]
  AreaLightSource "diffuse" "rgb L" [ 1 1 1 ]
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
AttributeBegin
  Material "dielectric" "float eta" [ 1.5 ] "float roughness" [ 0.3 ]
  Shape "sphere" "float radius" [ 2 ]
AttributeEnd
