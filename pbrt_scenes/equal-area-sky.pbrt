# @rt-category Test Scenes
# @rt-description Two spheres and a floor lit by an equal-area environment picture, the way pbrt-v4 reads a square infinite-light image.
# @rt-performance Fast
# @rt-size 6
# equal-area-sky.pbrt -- a LightSource "infinite" with a SQUARE picture (equal-area-sky.bmp, 64 x 64): pbrt-v4 reads it as an equal-area octahedral map (+z is the middle of
# the picture, the corners are -z), not as a latitude-longitude panorama. The picture has a zenith gradient (z up), a dark ground below z = -0.05, a warm sun toward
# (0.6, 0, 0.8) and a red band near y = +0.8, so a wrong mapping or a wrong turn shows. Rotate -90 1 0 0 turns pbrt's z-up map to this scene's y-up world.
#
# Original, not derived from any distributed scene, so it carries no licence constraints.

LookAt 0 2.2 7   0 0.6 0   0 1 0
Camera "perspective" "float fov" [ 38 ]
Film "rgb" "integer xresolution" [ 300 ] "integer yresolution" [ 300 ]
Sampler "halton" "integer pixelsamples" [ 128 ]

WorldBegin

AttributeBegin
  Rotate -90 1 0 0
  Rotate 35 0 0 1
  LightSource "infinite" "string filename" [ "equal-area-sky.bmp" ]
AttributeEnd

Material "diffuse" "rgb reflectance" [ 0.5 0.5 0.5 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -8 0 -8  8 0 -8  8 0 8  -8 0 8 ]
AttributeBegin
  Translate -1.3 0.9 0
  Material "diffuse" "rgb reflectance" [ 0.8 0.8 0.8 ]
  Shape "sphere" "float radius" [ 0.9 ]
AttributeEnd
AttributeBegin
  Translate 1.3 0.9 0
  Material "conductor" "float roughness" [ 0.05 ]
  Shape "sphere" "float radius" [ 0.9 ]
AttributeEnd
