<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- Prefix "/" keeps resource paths as ":/icons/<name>.svg" rather than
         the doubled ":/icons/icons/<name>.svg" a "/icons" prefix would give,
         since the files already live in an icons/ directory. -->
    <qresource prefix="/">
        <file alias="assets/downloadable_assets.txt">downloadable_assets.txt</file>
        <file alias="assets/scene_packs.txt">scene_packs.txt</file>
        <file>icons/render.svg</file>
        <!-- A picture of a sphere made of each ready-made material, for the Scene Builder's Preset list (scripts/make_material_thumbnails.py). -->
        <file>material_thumbs/aluminium.png</file>
        <file>material_thumbs/blue-plastic.png</file>
        <file>material_thumbs/brushed-steel.png</file>
        <file>material_thumbs/candle-wax.png</file>
        <file>material_thumbs/car-paint.png</file>
        <file>material_thumbs/ceramic.png</file>
        <file>material_thumbs/chalk.png</file>
        <file>material_thumbs/chrome.png</file>
        <file>material_thumbs/clay.png</file>
        <file>material_thumbs/concrete.png</file>
        <file>material_thumbs/copper.png</file>
        <file>material_thumbs/diamond.png</file>
        <file>material_thumbs/frosted-glass.png</file>
        <file>material_thumbs/glass.png</file>
        <file>material_thumbs/gold.png</file>
        <file>material_thumbs/jade.png</file>
        <file>material_thumbs/leaf.png</file>
        <file>material_thumbs/marble-stone.png</file>
        <file>material_thumbs/milk.png</file>
        <file>material_thumbs/mix-rusty-metal.png</file>
        <file>material_thumbs/mix-chipped-paint.png</file>
        <file>material_thumbs/mix-dusty-glass.png</file>
        <file>material_thumbs/mix-mossy-stone.png</file>
        <file>material_thumbs/mix-wet-sand.png</file>
        <file>material_thumbs/mix-worn-leather.png</file>
        <file>material_thumbs/mix-scuffed-plastic.png</file>
        <file>material_thumbs/mix-dirty-snow.png</file>
        <file>material_thumbs/paper.png</file>
        <file>material_thumbs/red-plastic.png</file>
        <file>material_thumbs/rubber.png</file>
        <file>material_thumbs/silver.png</file>
        <file>material_thumbs/skin.png</file>
        <file>material_thumbs/water.png</file>
        <file>material_thumbs/wax.png</file>
        <file>icons/stop.svg</file>
        <file>icons/pause.svg</file>
        <file>icons/skip_next.svg</file>
        <file>icons/video.svg</file>
        <file>icons/image.svg</file>
        <file>icons/folder.svg</file>
        <file>icons/copy.svg</file>
        <file>icons/save.svg</file>
        <file>icons/clear.svg</file>
        <file>icons/gpu.svg</file>
        <file>icons/cpu.svg</file>
        <file>icons/info.svg</file>
        <file>icons/chevron_up.svg</file>
        <file>icons/chevron_down.svg</file>
        <!-- Decorative motifs for the topical themes. Painted on the tab
             pane's background only - see theme::Palette::backgroundImage. -->
        <file>backgrounds/parchment.svg</file>
        <file>backgrounds/blueprint.svg</file>
        <file>backgrounds/arcade.svg</file>
        <file>backgrounds/blossom.svg</file>
        <file>backgrounds/comicpop.svg</file>
        <!-- Bundled so CJK glyphs are guaranteed to render regardless of
             platform or which Font menu choice is active (font_switch.cpp's
             applyFont()) - see fonts/OFL.txt for the SIL Open Font License
             this ships under. Kept under this shared prefix="/" rather than
             its own prefix="/fonts", same reason the comment above avoids a
             separate "/icons" prefix - a "/fonts" prefix here would double
             to ":/fonts/fonts/...". -->
        <file>fonts/NotoSansSC-Regular.ttf</file>
    </qresource>
</RCC>
