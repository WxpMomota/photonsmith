<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    One cl.exe per source file, started by MSBuild (UseMultiToolTask), instead of one cl.exe /MP per project. With /MP the tracking logs
    MSBuild uses to decide what is out of date lose the first source's command-line entry (every project here: tests 214 of 215, optix 9 of
    10, cpu_renderer 4 of 5), so that source always looked "changed" and the whole project recompiled on EVERY build - ~95 s for a build with
    no changes. EnforceProcessCountAcrossBuilds keeps the total number of cl.exe processes at the /m:N the build was asked for.
  -->
  <PropertyGroup>
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
  </PropertyGroup>

  <PropertyGroup>
	<!-- Hint that launcher is the main executable -->
	<IsStartupProject Condition="'$(MSBuildProjectName)' == 'launcher'">true</IsStartupProject>
  </PropertyGroup>

  <!--
    /FS (Force Synchronous PDB Writes): the solution builds multiple projects
    in parallel (scripts\build_all.ps1 and build_all.bat both pass /m), and
    without /FS concurrent cl.exe processes writing to a shared .pdb can
    corrupt it (LNK1103 "debugging information corrupt", LNK4020). Applies
    to every project by default; projects that already set their own
    AdditionalOptions/%(AdditionalOptions) pick this up automatically.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    Every program (ray_tracer.exe and the test programs) reads narrow-string paths as UTF-8, which is how the Scene Builder and the pbrt files it writes spell them: a user or folder name
    with an accented or non-Latin letter then works. The manifest only matters to a program, not to a library (a DLL or static library takes the setting of the program that loads it).
  -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'Application'">
    <Manifest>
      <AdditionalManifestFiles>$(MSBuildThisFileDirectory)resources\utf8.manifest %(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
</Project>
