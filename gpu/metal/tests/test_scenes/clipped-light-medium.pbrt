# clipped-light-medium.pbrt -- a partial sphere that is an area light (a bowl lamp: zmax cuts the top off), and a partial sphere that carries a medium (the renderers draw an open shell as a
# surface and do not fill it: pbrt_flatten::Sphere::cpuMediumUnsupported), which Metal drew whole. Compared with the CPU in 8 x 8 blocks by metal_poc_blocks_test.sh.
#
# Original, so it carries no licence constraints.

LookAt 0 3.5 8  0 0.8 0  0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 6 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.05 0.06 0.08 ]

Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -8 0 -8  8 0 -8  8 0 8  -8 0 8 ]

# a bowl lamp: the lower part of a sphere, open at the top, lit on its outside, hanging above a diffuse ball
AttributeBegin
  Translate -1.8 2.2 0
  Rotate -90 1 0 0
  AreaLightSource "diffuse" "rgb L" [ 8 6 4 ]
  Shape "sphere" "float radius" [ 1.0 ] "float zmax" [ 0.2 ]
AttributeEnd
AttributeBegin
  Translate -1.8 0.5 0
  Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.8 ]
  Shape "sphere" "float radius" 0.5
AttributeEnd

# a cap that carries a medium
AttributeBegin
  Translate 2 1 0
  Rotate -90 1 0 0
  MakeNamedMedium "fog" "string type" [ "homogeneous" ] "rgb sigma_a" [ 0.2 0.2 0.2 ] "rgb sigma_s" [ 1.5 1.5 1.5 ]
  MediumInterface "fog" ""
  Material "interface"
  Shape "sphere" "float radius" [ 0.9 ] "float zmin" [ -0.3 ]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 10 10 10 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ 0 5 -2  2 5 -2  2 5 2  0 5 2 ]
AttributeEnd
