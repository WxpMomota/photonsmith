# quadric-rough-pictures.pbrt -- a roughness picture and a Mix amount picture on a disk and a cylinder, which have no (u, v) of their own on Metal's analytic shapes: they are drawn as
# triangles when the material reads a picture per pixel. Compared with the CPU in 8 x 8 blocks by metal_poc_blocks_test.sh.
#
# Original, so it carries no licence constraints.

LookAt 0 2.2 6.5  0 1.1 0  0 1 0
Camera "perspective" "float fov" [ 45 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 6 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.3 0.35 0.45 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -3 6 -2  3 6 -2  3 6 2  -3 6 2 ]
AttributeEnd

Texture "rough" "float" "imagemap" "string filename" [ "../../../../pbrt_scenes/texture-params-rough.png" ] "string encoding" [ "linear" ]
Texture "amount" "float" "imagemap" "string filename" [ "../../../../pbrt_scenes/texture-params-amount.png" ] "string encoding" [ "linear" ]

# a strong checker floor, so a mirror-smooth surface shows a sharp pattern and a rough one a blur
Texture "floor" "spectrum" "checkerboard" "float uscale" [ 16 ] "float vscale" [ 16 ] "rgb tex1" [ 0.9 0.9 0.85 ] "rgb tex2" [ 0.05 0.1 0.45 ]
Material "diffuse" "texture reflectance" [ "floor" ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -8 0 -8  8 0 -8  8 0 12  -8 0 12 ] "point2 uv" [ 0 0  1 0  1 1  0 1 ]

# a conductor disk standing up, facing the camera
AttributeBegin
  Translate -2.3 1.4 0
  Material "conductor" "spectrum eta" "metal-Cu-eta" "spectrum k" "metal-Cu-k" "texture roughness" [ "rough" ]
  Shape "disk" "float radius" 1.3
AttributeEnd

# a coated diffuse cylinder standing on the floor
AttributeBegin
  Translate 0 0 0
  Rotate -90 1 0 0
  Material "coateddiffuse" "rgb reflectance" [ 0.7 0.2 0.15 ] "texture roughness" [ "rough" ]
  Shape "cylinder" "float radius" 0.8 "float zmin" 0 "float zmax" 1.8
AttributeEnd

# a Mix of two plain materials whose amount is a picture, on a disk
AttributeBegin
  Translate 2.3 1.4 0
  MakeNamedMaterial "red" "string type" [ "diffuse" ] "rgb reflectance" [ 0.8 0.15 0.1 ]
  MakeNamedMaterial "blue" "string type" [ "conductor" ] "spectrum eta" "metal-Au-eta" "spectrum k" "metal-Au-k" "float roughness" [ 0.05 ]
  Material "mix" "string materials" [ "red" "blue" ] "texture amount" [ "amount" ]
  Shape "disk" "float radius" 1.3
AttributeEnd
