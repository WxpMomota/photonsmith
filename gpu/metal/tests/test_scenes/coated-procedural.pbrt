# coated-procedural.pbrt -- a coated diffuse whose reflectance is a procedural texture (a checker floor, and spheres with dots, marble and a bilinear blend). Metal drew these as the flat colour the
# texture averages to, so the checker floor of the Ball Parade film came out 7-14% too dark and without its squares in the reflections. Compared with the CPU in 8 x 8 blocks by
# metal_poc_blocks_test.sh. Original, so it carries no licence constraints.

LookAt 0 2.6 8  0 0.7 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 64 ] "integer yresolution" [ 64 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 8 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.06 0.075 0.12 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 7 6.2 5.2 ]
  Shape "trianglemesh" "integer indices" [ 0 2 1 0 3 2 ] "point3 P" [ -3 5 -3  3 5 -3  3 5 3  -3 5 3 ]
AttributeEnd

Texture "floor-check" "spectrum" "checkerboard" "float uscale" [ 18 ] "float vscale" [ 10 ] "rgb tex1" [ 0.80 0.78 0.74 ] "rgb tex2" [ 0.30 0.32 0.40 ]
Material "coateddiffuse" "texture reflectance" [ "floor-check" ] "float roughness" [ 0.04 ]
Shape "trianglemesh" "integer indices" [ 0 2 1 0 3 2 ] "point3 P" [ -10 0 -10  10 0 -10  10 0 10  -10 0 10 ] "point2 uv" [ 0 0  1 0  1 1  0 1 ]

Texture "dots" "spectrum" "dots" "rgb inside" [ 0.9 0.2 0.2 ] "rgb outside" [ 0.2 0.3 0.8 ] "float uscale" [ 6 ] "float vscale" [ 6 ]
AttributeBegin
  Translate -2.2 0.8 0
  Material "coateddiffuse" "texture reflectance" [ "dots" ] "float roughness" [ 0.05 ]
  Shape "sphere" "float radius" 0.8
AttributeEnd
Texture "marble" "spectrum" "marble" "float scale" [ 2 ]
AttributeBegin
  Translate 0 0.8 0
  Material "coateddiffuse" "texture reflectance" [ "marble" ] "float roughness" [ 0.1 ]
  Shape "sphere" "float radius" 0.8
AttributeEnd
Texture "blend" "spectrum" "bilerp" "rgb v00" [ 0.9 0.1 0.1 ] "rgb v01" [ 0.1 0.9 0.1 ] "rgb v10" [ 0.1 0.1 0.9 ] "rgb v11" [ 0.9 0.9 0.1 ]
AttributeBegin
  Translate 2.2 0.8 0
  Material "coateddiffuse" "texture reflectance" [ "blend" ] "float roughness" [ 0.02 ]
  Shape "sphere" "float radius" 0.8
AttributeEnd
