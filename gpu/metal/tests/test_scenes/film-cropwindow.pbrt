# film-cropwindow.pbrt -- a lit sphere on a floor, the middle half (Film cropwindow 0.25 0.75 0.25 0.75). Used by metal_poc_crop_test.sh: the file's own Film "cropwindow" must give what --crop gives on the same scene.
#
# Original, so it carries no licence constraints.

LookAt 0 1 6  0 0.4 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Film "rgb" "integer xresolution" [ 128 ] "integer yresolution" [ 128 ] "float cropwindow" [ 0.25 0.75 0.25 0.75 ]
Sampler "halton" "integer pixelsamples" [ 16 ]
WorldBegin

LightSource "infinite" "rgb L" [ 0.4 0.45 0.6 ]
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 12 12 12 ]
  Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -2 4 2   2 4 2   2 4 -2   -2 4 -2 ]
AttributeEnd
Material "diffuse" "rgb reflectance" [ 0.7 0.7 0.7 ]
Shape "trianglemesh" "integer indices" [ 0 1 2  0 2 3 ] "point3 P" [ -6 0 -6   6 0 -6   6 0 6   -6 0 6 ]
Material "diffuse" "rgb reflectance" [ 0.8 0.3 0.2 ]
AttributeBegin
  Translate 0 1 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
