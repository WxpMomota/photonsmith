# A starter cartoon under the sea (python scripts/anim/film.py new wreck NAME): an old wreck, an octopus who lives in it, a moray in its hole, a giant clam and an
# anchor dropped from a boat. Change anything - the grammar is in docs/VIDEO_GENERATION.md ("Under the sea", rounds 14 to 17). Heights on the sea's lines are above the
# seabed, 15 m down here; a character's y and the camera's keys are the world's (the surface is at 0).
film    {{key}}
name    {{name}}
about   An octopus shows a little fish round the old wreck where it lives - and something comes down from the boat above.
scene   film_assets/wild/set.pbrt
length  26
tags    cartoon, underwater

toon       bands 3  lines 2
water      sea  level 0  waves 0.5
sky        15:00 15:00 south 40 physical
underwater clarity 1.2  colour blue
exposure   auto

wreck      -6 -16  toward 70  length 28  list 12
moray      -2.5 0.3 -9  toward 140  at 8.5
clam       2 -8  shut 12.8
shells     30 in -4 -10 4 -4
boat       2 -12  toward 90  length 8  speed 0  during 0 26
sink       anchor 1.5 16 -10  at 15

character  olly octopus  at -1 -14.6 -5.5  facing 160
character  finn fish  at 1 -13.6 -4.5  facing 200
say        olly  1 "Welcome to my house!"
gesture    olly  "wave" 1 1.4 3 3.4
say        finn  4.5 "It's a bit... broken."
gesture    finn  "shrug" 4.5 4.9 6.2 6.6
say        olly  10 "Don't mind Morris. He's shy."
say        finn  11.6 "What's in there?"
say        olly  13.4 "Not your fins!"
look       finn  at 1.5 -12 -10 15.5 16 22 22.5
say        finn  17 "Something's coming down!"
feel       finn  surprised 16.8 17.2 20 20.5

shot 0 The wreck
  key   2.5 -12.8 1   -3 -14 -10   55
  key   1.5 -13.2 -0.5   -2 -14.2 -9   50
shot 7.5 The moray
  key   -0.8 -14 -6.5   -2.5 -14.6 -9   38
shot 11.5 The clam
  key   0.5 -14 -5.6   2 -14.8 -8   40
shot 15.5 Coming down
  key   2.6 -14.2 -5   1.5 -12 -10   55
  key   2.6 -14.2 -5   1.5 -14.4 -10   55
